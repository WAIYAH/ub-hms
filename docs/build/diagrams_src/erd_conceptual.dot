digraph conceptual {
  graph [fontname="Arial", fontsize=12, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=10, color="black", fontcolor="black", arrowsize=0.9];
  rankdir=TB; nodesep=0.25; ranksep=0.55; node [shape=box, fontsize=12, margin="0.12,0.07"];
  roles [label="Role"];
  users [label="User (staff)"];
  audit_log [label="Audit entry"];
  patients [label="Patient"];
  appointments [label="Appointment"];
  visits [label="Visit"];
  triage [label="Triage record"];
  consultations [label="Consultation"];
  visit_services [label="Visit service"];
  services [label="Service"];
  icd10_codes [label="ICD-10 code"];
  lab_requests [label="Laboratory request"];
  lab_tests [label="Laboratory test"];
  prescriptions [label="Prescription"];
  prescription_items [label="Prescription item"];
  medicines [label="Medicine"];
  medicine_batches [label="Medicine batch"];
  stock_movements [label="Stock movement"];
  invoices [label="Invoice"];
  invoice_items [label="Invoice item"];
  payments [label="Payment"];
  refund_requests [label="Refund request"];
  doctor_schedules [label="Doctor hours"];
  doctor_leave [label="Doctor leave"];
  data_requests [label="Data request"];
  public_requests [label="Public request"];
  roles -> users [arrowtail=tee, arrowhead=crow, dir=both, label=" has "];
  users -> audit_log [arrowtail=tee, arrowhead=crow, dir=both, label=" is recorded in "];
  patients -> appointments [arrowtail=tee, arrowhead=crow, dir=both, label=" books "];
  patients -> visits [arrowtail=tee, arrowhead=crow, dir=both, label=" makes "];
  appointments -> visits [arrowtail=tee, arrowhead=crow, dir=both, label=" leads to "];
  visits -> triage [arrowtail=tee, arrowhead=crow, dir=both, label=" has "];
  visits -> consultations [arrowtail=tee, arrowhead=crow, dir=both, label=" has "];
  visits -> visit_services [arrowtail=tee, arrowhead=crow, dir=both, label=" includes "];
  services -> visit_services [arrowtail=tee, arrowhead=crow, dir=both, label=" priced by "];
  services -> consultations [arrowtail=tee, arrowhead=crow, dir=both, label=" charged as "];
  icd10_codes -> consultations [arrowtail=tee, arrowhead=crow, dir=both, label=" codes "];
  visits -> lab_requests [arrowtail=tee, arrowhead=crow, dir=both, label=" needs "];
  lab_tests -> lab_requests [arrowtail=tee, arrowhead=crow, dir=both, label=" is "];
  visits -> prescriptions [arrowtail=tee, arrowhead=crow, dir=both, label=" gets "];
  prescriptions -> prescription_items [arrowtail=tee, arrowhead=crow, dir=both, label=" lists "];
  medicines -> prescription_items [arrowtail=tee, arrowhead=crow, dir=both, label=" is "];
  medicines -> medicine_batches [arrowtail=tee, arrowhead=crow, dir=both, label=" is held in "];
  medicine_batches -> stock_movements [arrowtail=tee, arrowhead=crow, dir=both, label=" changes by "];
  medicines -> stock_movements [arrowtail=tee, arrowhead=crow, dir=both, label=" moves "];
  visits -> invoices [arrowtail=tee, arrowhead=crow, dir=both, label=" is billed on "];
  invoices -> invoice_items [arrowtail=tee, arrowhead=crow, dir=both, label=" has "];
  invoices -> payments [arrowtail=tee, arrowhead=crow, dir=both, label=" is paid by "];
  payments -> refund_requests [arrowtail=tee, arrowhead=crow, dir=both, label=" is reversed through "];
  users -> doctor_schedules [arrowtail=tee, arrowhead=crow, dir=both, label=" works to "];
  users -> doctor_leave [arrowtail=tee, arrowhead=crow, dir=both, label=" takes "];
  patients -> data_requests [arrowtail=tee, arrowhead=crow, dir=both, label=" is the subject of "];
  users -> public_requests [arrowtail=tee, arrowhead=crow, dir=both, label=" handles "];
  patients -> audit_log [style=invis];
}

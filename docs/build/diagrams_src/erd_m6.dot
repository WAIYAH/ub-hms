digraph erd_m6 {
  graph [fontname="Arial", fontsize=12, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=10, color="black", fontcolor="black", arrowsize=0.9];
  rankdir=TB; nodesep=0.45; ranksep=0.9;
  roles [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR></TABLE>>];
  users [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOL</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">must_change_password</TD><TD ALIGN="LEFT">BOOL</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">failed_attempts</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">locked_until</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">last_login_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  audit_log [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>audit_log</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">entity</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  public_requests [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>public_requests</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">department</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">requested_role</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">staff_number</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">supervisor</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">topic</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">admin_note</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">handled_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">handled_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  doctor_schedules [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>doctor_schedules</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">doctor_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">weekday</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">TIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">TIME</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  doctor_leave [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>doctor_leave</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">doctor_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  users -> roles [arrowtail=crow, arrowhead=tee, dir=both];
}

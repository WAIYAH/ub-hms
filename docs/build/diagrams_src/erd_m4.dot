digraph erd_m4 {
  graph [fontname="Arial", fontsize=12, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=10, color="black", fontcolor="black", arrowsize=0.9];
  rankdir=LR; nodesep=0.45; ranksep=0.9;
  medicines [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>medicines</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">form</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">strength</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">unit</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reorder_level</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOL</TD></TR></TABLE>>];
  medicine_batches [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>medicine_batches</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">medicine_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">batch_no</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">expiry_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  prescriptions [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>prescriptions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">visit_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">prescribed_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  prescription_items [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>prescription_items</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">prescription_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">medicine_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">dosage</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">frequency</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">duration</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">dispensed_qty</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  stock_movements [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>stock_movements</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">medicine_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  visits [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>visits</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  medicine_batches -> medicines [arrowtail=crow, arrowhead=tee, dir=both];
  prescriptions -> visits [arrowtail=crow, arrowhead=tee, dir=both];
  prescription_items -> medicines [arrowtail=crow, arrowhead=tee, dir=both];
  prescription_items -> prescriptions [arrowtail=crow, arrowhead=tee, dir=both];
  stock_movements -> medicine_batches [arrowtail=crow, arrowhead=tee, dir=both];
  stock_movements -> medicines [arrowtail=crow, arrowhead=tee, dir=both];
}

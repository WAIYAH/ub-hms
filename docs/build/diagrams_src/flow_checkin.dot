digraph checkin {
  graph [fontname="Arial", fontsize=13, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=13, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=11, color="black", fontcolor="black", arrowsize=0.8];
  rankdir=TB; nodesep=0.3; ranksep=0.24;
  node [fontsize=12, margin="0.1,0.05"];
  edge [fontsize=11];
  s [shape=box, style="rounded,bold", penwidth=1.5, label="Start: patient arrives"];
  d0 [shape=diamond, margin="0.0,0.0", label="Open visit already?"];
  x0 [shape=parallelogram, label="Refuse; show the open\nvisit"];
  d1 [shape=diamond, margin="0.0,0.0", label="Booked appointment\ntoday?"];
  a1 [shape=box, label="Mark the appointment Attended"];
  a2 [shape=box, label="Record a walk-in"];
  v [shape=box, label="Open the visit (waiting for\ntriage)"];
  tr [shape=parallelogram, label="Nurse enters the vital\nsigns"];
  d2 [shape=diamond, margin="0.0,0.0", label="Values plausible?"];
  e1 [shape=parallelogram, label="Show messages and ask\nagain"];
  st [shape=box, label="Save triage and write the\naudit entry (visit is now\nwaiting for the doctor)"];
  f [shape=box, style="rounded,bold", penwidth=1.5, label="End"];
  {rank=same; d0; x0;}
  {rank=same; a1; a2;}
  {rank=same; d2; e1;}
  s -> d0;
  d0 -> x0 [label="yes"];
  d0 -> d1 [label="no"];
  d1 -> a1 [label="yes"];
  d1 -> a2 [label="no"];
  a1 -> v;
  a2 -> v;
  v -> tr;
  tr -> d2;
  d2 -> e1 [label="no"];
  e1 -> tr [constraint=false];
  d2 -> st [label="yes"];
  st -> f;
}

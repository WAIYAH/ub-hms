digraph erd_m3 {
  graph [fontname="Arial", fontsize=12, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=10, color="black", fontcolor="black", arrowsize=0.9];
  rankdir=LR; nodesep=0.45; ranksep=0.9;
  lab_tests [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>lab_tests</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reference_range</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOL</TD></TR></TABLE>>];
  lab_requests [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>lab_requests</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">visit_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">test_id</TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">requested_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">clinical_notes</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">requested_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">is_abnormal</TD><TD ALIGN="LEFT">BOOL</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">result_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">result_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  visits [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>visits</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  lab_requests -> lab_tests [arrowtail=crow, arrowhead=tee, dir=both];
  lab_requests -> visits [arrowtail=crow, arrowhead=tee, dir=both];
}

digraph erd_m1 {
  graph [fontname="Arial", fontsize=12, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=10, color="black", fontcolor="black", arrowsize=0.9];
  rankdir=LR; nodesep=0.45; ranksep=0.9;
  patients [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>patients</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">op_number</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">middle_name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">sex</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">date_of_birth</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">dob_estimated</TD><TD ALIGN="LEFT">BOOL</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">national_id</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">residence</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">allergies</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">next_of_kin_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">next_of_kin_phone</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">next_of_kin_relation</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">registered_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  op_sequences [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>op_sequences</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">year</TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">last_number</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  appointments [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>appointments</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">doctor_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">appointment_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">TIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">TIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">cancel_reason</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">booked_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">slot_key</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR></TABLE>>];
  appointments -> patients [arrowtail=crow, arrowhead=tee, dir=both];
}

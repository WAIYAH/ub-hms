digraph erd_m5 {
  graph [fontname="Arial", fontsize=12, bgcolor="white", pad="0.15"];
  node  [fontname="Arial", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Arial", fontsize=10, color="black", fontcolor="black", arrowsize=0.9];
  rankdir=LR; nodesep=0.45; ranksep=0.9;
  invoices [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>invoices</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">invoice_no</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">visit_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">total</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">amount_paid</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  invoice_items [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>invoice_items</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">invoice_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">line_total</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR></TABLE>>];
  payments [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>payments</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">invoice_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">refund_of</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">method</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">received_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
  refund_requests [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>refund_requests</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">payment_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">invoice_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">refund_reference</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">requested_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">requested_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">decided_by</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">decided_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">&nbsp;</TD><TD ALIGN="LEFT">decision_note</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">refund_payment_id</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  visits [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" SIDES="B" BORDER="1" ALIGN="CENTER"><B>visits</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  invoices -> visits [arrowtail=crow, arrowhead=tee, dir=both];
  invoice_items -> invoices [arrowtail=crow, arrowhead=tee, dir=both];
  payments -> invoices [arrowtail=crow, arrowhead=tee, dir=both];
  payments -> payments [arrowtail=crow, arrowhead=tee, dir=both];
  refund_requests -> invoices [arrowtail=crow, arrowhead=tee, dir=both];
  refund_requests -> payments [arrowtail=crow, arrowhead=tee, dir=both];
  refund_requests -> payments [arrowtail=crow, arrowhead=tee, dir=both];
}
